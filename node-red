    {
        "id": "70892e245c6b4b52",
        "type": "function",
        "z": "3f33f7ac38e608e1",
        "name": "Auftrag erzeugen",
        "func": "// Anfrage der App (Text-Body mit JSON)\nlet req = {};\ntry { req = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : (msg.payload || {}); } catch (e) {}\n\nconst rnd = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;\nconst pick = list => list[Math.floor(Math.random() * list.length)];\n\nlet machineStart = flow.get('machineStart');\nif (!machineStart) {\n    machineStart = new Date(Date.now() - rnd(20 * 60, 8 * 3600) * 1000).toISOString();\n    flow.set('machineStart', machineStart);\n}\nconst scanCount = (flow.get('scanCount') || 0) + 1;\nflow.set('scanCount', scanCount);\n\nlet kugeln = ['Blau', 'Rot', 'Grün']\n    .map(farbe => ({ farbe, anzahl: rnd(0, 5) }))\n    .filter(k => k.anzahl > 0);\nif (kugeln.length === 0) kugeln = [{ farbe: pick(['Blau', 'Rot', 'Grün']), anzahl: rnd(1, 5) }];\n\nconst auftrag = {\n    orderNumber: 'AUF-' + String(rnd(1, 99999)).padStart(5, '0'),\n    palletNumber: String(rnd(1, 9999)).padStart(4, '0'),\n    palletCount: rnd(4, 20),\n    order: { dose: 'Weiß', deckel: pick(['Blau', 'Rot', 'Grün']), kugeln },\n    vibration: flow.get('vibration') ?? null,\n    machineStart,\n    scanCount,\n    marker: req.marker || null,\n    timestamp: new Date().toISOString()\n};\nflow.set('lastOrder', auftrag);\n\nmsg.statusCode = 201;   // Created\nmsg.headers = {\n    'Access-Control-Allow-Origin': '*',\n    'Content-Type': 'application/json; charset=utf-8',\n    'Cache-Control': 'no-store'\n};\nmsg.payload = auftrag;\nnode.status({ fill: 'green', shape: 'dot', text: '201 · ' + auftrag.orderNumber + ' · Scan ' + scanCount });\nreturn msg;",
