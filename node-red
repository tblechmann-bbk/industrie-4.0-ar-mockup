        "z": "3f33f7ac38e608e1",
        "name": "Antwort bauen",
        "func": "msg.headers = {\n    'Access-Control-Allow-Origin': '*',\n    'Content-Type': 'application/json; charset=utf-8',\n    'Cache-Control': 'no-store'\n};\nconst r = (msg.payload && msg.payload[0]) || {};\n\nif (!r.count) {\n    msg.statusCode = 404;\n    msg.payload = { error: 'Keine Werte in den letzten ' + msg.minuten + ' Minuten', minuten: msg.minuten, count: 0 };\n} else {\n    msg.statusCode = 200;\n    msg.payload = {\n        average: r.avg,\n        count: r.count,\n        min: r.min,\n        max: r.max,\n        minuten: msg.minuten,\n        from: new Date(r.from_ts).toISOString(),\n        to: new Date(r.to_ts).toISOString(),\n        nodeId: 'ns=2;s=Demo.Alarms.Plant.PowerHouse.P-101.Vibration'\n    };\n    node.status({ fill: 'blue', shape: 'dot', text: 'Ø ' + r.avg.toFixed(3) + ' aus ' + r.count + ' Werten' });\n}\nreturn msg;",
